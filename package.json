{
  "name": "chatnip",
  "version": "0.1.0",
  "description": "One local inbox for Outlook, Teams, Gmail, Slack, IMAP and calendars",
  "type": "module",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "dev": "node scripts/icons.mjs && node scripts/svelte-runtime.mjs && vite dev",
    "build": "node scripts/icons.mjs && node scripts/svelte-runtime.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . --ext .js,.svelte,.ts",
    "lint:fix": "eslint . --ext .js,.svelte,.ts --fix",
    "format": "prettier --write '{src,static}/**/*.{js,ts,svelte,html,css,json}'",
    "format:check": "prettier --check '{src,static}/**/*.{js,ts,svelte,html,css,json}'",
    "tauri": "tauri",
    "runtime": "node scripts/svelte-runtime.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "~2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/svelte": "1.7.1",
    "codemirror": "6.0.2",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "emojibase-data": "^18.0.0",
    "marked": "^18.1.3",
    "overlayscrollbars": "^2.17.0",
    "sly-svelte-pane": "^1.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.554",
    "@iconify/svelte": "^5.2.4",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SlyOtis/chatnip"
  },
  "author": "Martin Ottersland",
  "packageManager": "pnpm@12.14.0"
}
